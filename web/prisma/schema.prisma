generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  identity            IdentityVerification?
  listings            Listing[]
  sentMessages        Message[]
  renterConversations Conversation[] @relation("RenterConversations")
  hostConversations   Conversation[] @relation("HostConversations")
  payments            Payment[]
  renterLeases        Lease[]        @relation("RenterLeases")
  hostLeases          Lease[]        @relation("HostLeases")
  sessions            Session[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model IdentityVerification {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String    @default("unverified")
  provider          String    @default("demo")
  stripeSessionId   String?
  legalName         String?
  dateOfBirth       String?
  documentType      String?
  livenessPassed    Boolean   @default(false)
  addressConfirmed  Boolean   @default(false)
  notes             String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model City {
  id        String    @id
  name      String
  state     String
  rank      Int
  lat       Float
  lng       Float
  walk      Int
  transit   Int
  featured  Boolean   @default(false)

  // Market context — powers the Leak Score (all-in vs local median)
  avgRoom       Int     @default(0)
  avgFurnished  Int     @default(0)
  country       String  @default("US")
  countryName   String  @default("United States")
  group         String  @default("United States")
  slug          String  @default("")
  // string[] of neighbourhood names
  neighborhoods Json    @default("[]")
  currency      String  @default("USD")

  listings  Listing[]

  @@index([rank])
  @@index([slug])
  @@index([country])
}

model Listing {
  id              String   @id
  cityId          String
  city            City     @relation(fields: [cityId], references: [id])
  hostId          String
  host            User     @relation(fields: [hostId], references: [id])
  operatorId      String?
  operator        Operator? @relation(fields: [operatorId], references: [id])
  housingType     String
  title           String
  address         String
  neighborhood    String
  price           Int
  allIn           Int
  // allIn is in the market's own currency; allInUsd is the comparable figure
  // every cross-market sort and budget filter runs on.
  currency        String   @default("USD")
  allInUsd        Int      @default(0)
  deposit         Int
  beds            Int
  baths           Float
  sqft            Int
  lat             Float
  lng             Float
  image           String
  description     String
  minStayMonths   Int
  availableFrom   String
  furnishedLevel  String
  verified        Boolean  @default(true)
  noFee           Boolean  @default(true)
  amenitiesJson   String

  // --- Filterable/sortable columns (kept as real columns so the API can
  //     index and query them rather than filtering in application code) ---
  maxStayMonths   Int      @default(12)
  privateBath     Boolean  @default(false)
  workplaceReady  Boolean  @default(false)
  petsPolicy      String   @default("none")
  utilitiesIncl   Boolean  @default(false)
  scamShield      Boolean  @default(true)
  featured        Boolean  @default(false)
  remainingMonths Int?
  leaseEnd        String?
  takeoverType    String?
  postedAt        DateTime @default(now())

  // --- Presentational detail. One JSON column rather than ~15 sparse
  //     columns nothing ever filters on: fees, housemates, furniture,
  //     images, specs, neighborhoodScores, host, building, commuteNote. ---
  detail          Json     @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations Conversation[]
  leases        Lease[]
  payments      Payment[]

  @@index([cityId])
  @@index([housingType])
  @@index([hostId])
  @@index([operatorId])
  @@index([allInUsd])
  @@index([availableFrom])
  @@index([featured])
  @@index([housingType, cityId])
}

/// A landlord, portfolio or co-living brand. Holds identity only — counts,
/// price floors, verification and reply times are derived from the listings
/// at query time so they cannot go stale.
model Operator {
  id        String @id
  slug      String @unique
  name      String
  /// coliving | portfolio | landlord
  kind      String
  tagline   String  @default("")
  since     Int?
  scope     String  @default("")

  listings  Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId      String
  hostId        String
  renter        User      @relation("RenterConversations", fields: [renterId], references: [id], onDelete: Cascade)
  host          User      @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@unique([listingId, renterId])
  @@index([renterId])
  @@index([hostId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id])
  kind            String
  amount          Int
  currency        String   @default("usd")
  status          String   @default("pending")
  stripeSessionId String?  @unique
  planId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Lease {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId        String
  hostId          String
  renter          User      @relation("RenterLeases", fields: [renterId], references: [id], onDelete: Cascade)
  host            User      @relation("HostLeases", fields: [hostId], references: [id], onDelete: Cascade)
  status          String    @default("draft")
  startDate       String
  endDate         String
  monthlyAllIn    Int
  deposit         Int
  terms           String
  renterSignature String?
  renterSignedAt  DateTime?
  hostSignature   String?
  hostSignedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([renterId])
  @@index([hostId])
}
