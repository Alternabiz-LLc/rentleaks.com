generator client {
  provider = "prisma-client-js"
  // No `output`: OpenNext (Cloudflare) expects the client in node_modules.
  // Workers reach Postgres through @prisma/adapter-pg, see lib/prisma.ts.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon/Supabase: DATABASE_URL is the pooled address (for the app),
  // DIRECT_URL the direct one (for migrations). Locally both are the same.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Founder controls. A suspended account cannot sign in and its sessions
  // are revoked; its listings are paused by the same action.
  suspendedAt   DateTime?
  suspendReason String?
  // A free listing trial granted by an invite (see TrialInvite).
  trialEndsAt   DateTime?

  // Staff (role "staff"): the desk modules this employee may open, as access
  // keys from lib/access.ts. The founder (role "admin") ignores this list.
  staffAccess    String[]  @default([])
  staffTitle     String?
  staffInvitedAt DateTime?
  staffJoinedAt  DateTime?
  invitedById    String?

  // Two-factor sign-in (authenticator app, RFC 6238). Secrets are sealed with
  // AUTH_SECRET (lib/security/seal.ts); the database never holds them plain.
  totpSecret        String?
  totpPendingSecret String?
  totpEnabledAt     DateTime?
  // The last 30-second step accepted, so a code cannot be replayed.
  totpLastStep      Int?
  mfaFailures       Int       @default(0)
  mfaLockedUntil    DateTime?
  lastSignInAt      DateTime?
  // Morning brief: hour of day in New York (null = off) and the last send.
  briefHour         Int?
  briefLastSentAt   DateTime?

  identity            IdentityVerification?
  listings            Listing[]
  sentMessages        Message[]
  renterConversations Conversation[] @relation("RenterConversations")
  hostConversations   Conversation[] @relation("HostConversations")
  payments            Payment[]
  renterLeases        Lease[]        @relation("RenterLeases")
  hostLeases          Lease[]        @relation("HostLeases")
  sessions            Session[]

  // Mobile app (see MOBILE-APP.md)
  savedListings  SavedListing[]
  savedSearches  SavedSearch[]
  pushDevices    PushDevice[]
  reportsFiled   Report[]    @relation("ReportsFiled")
  blocksMade     UserBlock[] @relation("BlocksMade")
  blocksReceived UserBlock[] @relation("BlocksReceived")
  trialInvites   TrialInvite[]
  contact        Contact?
  recoveryCodes  RecoveryCode[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Set when this session passed the second factor. Desk pages and staff
  // actions refuse sessions without it.
  mfaAt     DateTime?
  // Shown on the Security page so a member can recognise their devices.
  userAgent String?
  // "session" (web or app sign-in) or a single-use helper row that shares the
  // table: "mfa" (between password and code), "reset", "invite", "handoff".
  kind      String    @default("session")

  @@index([userId])
}

/// Single-use recovery codes for a lost authenticator. Stored as sha256 —
/// the codes are random (50 bits), so a fast hash is enough.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model IdentityVerification {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String    @default("unverified")
  provider          String    @default("demo")
  stripeSessionId   String?
  legalName         String?
  dateOfBirth       String?
  documentType      String?
  livenessPassed    Boolean   @default(false)
  addressConfirmed  Boolean   @default(false)
  notes             String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model City {
  id        String    @id
  name      String
  state     String
  rank      Int
  lat       Float
  lng       Float
  walk      Int
  transit   Int
  featured  Boolean   @default(false)

  // Market context — powers the Leak Score (all-in vs local median)
  avgRoom       Int     @default(0)
  avgFurnished  Int     @default(0)
  country       String  @default("US")
  countryName   String  @default("United States")
  group         String  @default("United States")
  slug          String  @default("")
  // string[] of neighbourhood names
  neighborhoods Json    @default("[]")
  currency      String  @default("USD")

  listings  Listing[]

  @@index([rank])
  @@index([slug])
  @@index([country])
}

model Listing {
  id              String   @id
  cityId          String
  city            City     @relation(fields: [cityId], references: [id])
  hostId          String
  host            User     @relation(fields: [hostId], references: [id])
  operatorId      String?
  operator        Operator? @relation(fields: [operatorId], references: [id])
  housingType     String
  title           String
  address         String
  neighborhood    String
  price           Int
  allIn           Int
  // allIn is in the market's own currency; allInUsd is the comparable figure
  // every cross-market sort and budget filter runs on.
  currency        String   @default("USD")
  allInUsd        Int      @default(0)
  deposit         Int
  beds            Int
  baths           Float
  sqft            Int
  lat             Float
  lng             Float
  image           String
  description     String
  minStayMonths   Int
  availableFrom   String
  furnishedLevel  String
  verified        Boolean  @default(true)
  noFee           Boolean  @default(true)
  amenitiesJson   String

  // --- Filterable/sortable columns (kept as real columns so the API can
  //     index and query them rather than filtering in application code) ---
  maxStayMonths   Int      @default(12)
  privateBath     Boolean  @default(false)
  workplaceReady  Boolean  @default(false)
  petsPolicy      String   @default("none")
  utilitiesIncl   Boolean  @default(false)
  scamShield      Boolean  @default(true)
  featured        Boolean  @default(false)
  remainingMonths Int?
  leaseEnd        String?
  takeoverType    String?
  postedAt        DateTime @default(now())

  // --- Composer fields. Real columns where something filters, sorts or
  //     ranks on them; JSON strings for the arrays that only ever render.
  //     availableUntil is the one that unlocks date-range search: without an
  //     end date "available March through June" is not answerable. ---
  availableUntil  String?
  listedBy        String   @default("owner")
  addressPrivacy  String   @default("street-only")
  status          String   @default("active")
  scheduledAt     String?
  vouchersAccepted Boolean @default(true)
  registrationNumber String?
  consentStatus   String?
  accessibilityJson String @default("[]")
  feesJson        String   @default("[]")

  // --- Review. Nothing reaches the public catalogue until a human has looked
  //     at it. `moderation` is separate from `status` on purpose: status is
  //     the seller's switch (active, coming-soon, paused) and moderation is
  //     ours, so a seller cannot unpause their way past a decline. ---
  moderation      String   @default("pending")
  moderationNote  String?
  moderatedAt     DateTime?
  moderatedById   String?

  // --- Paid placement. Scoped to the listing's own market: a sponsored slot
  //     is only ever promoted where the search resolves to that city. ---
  sponsored       Boolean  @default(false)
  plan            String   @default("week")

  // --- Catalogue health. `confirmedAt` is the host's last "still available"
  //     answer; `freshnessAskedAt` the last time we asked. ---
  confirmedAt       DateTime?
  freshnessAskedAt  DateTime?
  fixRequestedAt    DateTime?

  // --- Presentational detail. One JSON column rather than ~15 sparse
  //     columns nothing ever filters on: fees, housemates, furniture,
  //     images, specs, neighborhoodScores, host, building, commuteNote. ---
  detail          Json     @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations Conversation[]
  leases        Lease[]
  payments      Payment[]
  savedBy       SavedListing[]
  reports       Report[]
  leads         Lead[]

  @@index([cityId])
  @@index([housingType])
  @@index([hostId])
  @@index([operatorId])
  @@index([allInUsd])
  @@index([availableFrom])
  @@index([featured])
  @@index([housingType, cityId])
  @@index([availableUntil])
  @@index([status])
  @@index([sponsored, cityId])
  @@index([vouchersAccepted])
  @@index([moderation])
}

/// A landlord, portfolio or co-living brand. Holds identity only — counts,
/// price floors, verification and reply times are derived from the listings
/// at query time so they cannot go stale.
model Operator {
  id        String @id
  slug      String @unique
  name      String
  /// coliving | portfolio | landlord
  kind      String
  tagline   String  @default("")
  since     Int?
  scope     String  @default("")

  listings  Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId      String
  hostId        String
  renter        User      @relation("RenterConversations", fields: [renterId], references: [id], onDelete: Cascade)
  host          User      @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime  @default(now())
  // Read receipts per side, so each inbox can count its own unread.
  renterReadAt  DateTime?
  hostReadAt    DateTime?
  // open | archived. A blocked pair is enforced through UserBlock, not here.
  status        String    @default("open")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@unique([listingId, renterId])
  @@index([renterId])
  @@index([hostId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  // JSON string[] of scam-guard signals raised on this message (wire
  // transfer, pay-before-viewing, off-platform push...). Shown as a warning
  // to the recipient; never used to silently drop a message.
  flags          String       @default("[]")
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id])
  kind            String
  amount          Int
  currency        String   @default("usd")
  status          String   @default("pending")
  stripeSessionId String?  @unique
  planId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Lease {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId        String
  hostId          String
  renter          User      @relation("RenterLeases", fields: [renterId], references: [id], onDelete: Cascade)
  host            User      @relation("HostLeases", fields: [hostId], references: [id], onDelete: Cascade)
  status          String    @default("draft")
  startDate       String
  endDate         String
  monthlyAllIn    Int
  deposit         Int
  terms           String
  renterSignature String?
  renterSignedAt  DateTime?
  hostSignature   String?
  hostSignedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([renterId])
  @@index([hostId])
}

/* ------------------------------------------------------------------------
   Mobile app — models added for the native client (MOBILE-APP.md).
   ------------------------------------------------------------------------ */

/// Saved homes, per account rather than per browser (brief §4.5).
model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

/// A stored browse query. When `alerts` is on, the alert job pushes newly
/// approved listings that match it.
model SavedSearch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  query         Json     @default("{}")
  alerts        Boolean  @default(true)
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([alerts])
}

/// Expo push token for a signed-in device.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A user report against a listing, an account or a message. Worked from the
/// founder queue. Required for user-generated content on the app stores.
model Report {
  id            String    @id @default(cuid())
  reporterId    String
  reporter      User      @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  subjectUserId String?
  messageId     String?
  /// scam | misleading | discriminatory | unavailable | abusive | other
  reason        String
  note          String    @default("")
  /// open | actioned | dismissed
  status        String    @default("open")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@index([listingId])
  @@index([reporterId])
}

/// One account refusing messages from another.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A lead from a public form — above all the Facebook landing page
/// (rentleaks.com/facebook.html). `match` asks to be matched to a home,
/// `viewing` asks to see one listing, `stay` asks to book one listing for set
/// dates. No money moves: the host accepts or declines. Contact details were
/// given, with consent, for this request, and are shown only to the founder and
/// to the host of the listing asked about.
model Lead {
  id           String    @id @default(cuid())
  kind         String
  // new | contacted | booked | closed | spam
  status       String    @default("new")
  listingId    String?
  listing      Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  cityId       String?
  housingType  String?
  budgetMax    Int?
  currency     String    @default("USD")
  moveIn       String?
  moveOut      String?
  stayMonths   Int?
  // JSON [{ date, window }] — up to three preferred viewing slots.
  viewingSlots String    @default("[]")
  viewingMode  String?
  message      String    @default("")
  consent      Boolean   @default(false)
  // fb_page | fb_button | fb_post | fb_ad | messenger | instagram | web
  source       String    @default("web")
  campaign     String?
  referrer     String?
  // The founder's private note; never shown to the renter or the host.
  note         String?
  contactedAt  DateTime?
  // Speed-to-lead: the instant reply, the one-hour escalation, the shortlist.
  ackSentAt         DateTime?
  escalatedAt       DateTime?
  assignedToId      String?
  matchesSentAt     DateTime?
  matchIds          String    @default("[]")
  shortlistOpenedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([listingId])
}

/* ------------------------------------------------------------------------
   Founder tools: CRM, outreach, campaigns, social, ads, trials, audit.
   ------------------------------------------------------------------------ */

/// One person or company the business talks to — a renter, a host, an
/// operator to recruit, a partner. Leads and sign-ups create or update one
/// automatically; outreach prospects are added by hand or imported.
/// `marketingConsent` is the only thing that puts a contact in a newsletter
/// or bulk send; `unsubscribedAt` takes them out for good.
model Contact {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String    @default("")
  phone            String?
  company          String?
  // renter | host | operator | partner | press | other
  kind             String    @default("renter")
  // new | contacted | qualified | customer | lost
  stage            String    @default("new")
  // JSON string[]
  tags             String    @default("[]")
  // lead | signup | import | manual | newsletter | invite
  source           String    @default("manual")
  cityId           String?
  note             String?
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  marketingConsent Boolean   @default(false)
  consentAt        DateTime?
  consentSource    String?
  unsubscribedAt   DateTime?
  // Newsletter double opt-in: set until the address is confirmed.
  confirmToken     String?   @unique
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities ContactActivity[]
  sends      CampaignSend[]

  @@index([kind])
  @@index([stage])
  @@index([nextFollowUpAt])
  @@index([marketingConsent])
  @@index([createdAt])
}

/// The timeline on a contact: notes, calls, emails, stage changes.
model ContactActivity {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // note | email | call | sms | meeting | stage | lead | campaign | trial | signup
  kind      String
  subject   String   @default("")
  body      String   @default("")
  actorId   String?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

/// Reusable message. Merge fields: {{name}}, {{first_name}}, {{email}},
/// {{city}}, {{invite_link}}, {{app_url}}.
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  // outreach | newsletter | bulk | trial
  purpose   String   @default("outreach")
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A bulk email: newsletter, announcement or outreach wave. Recipients are
/// frozen into CampaignSend rows when sending starts; the outbox job sends
/// them in small batches.
model Campaign {
  id          String    @id @default(cuid())
  name        String
  // newsletter | bulk | outreach
  kind        String    @default("newsletter")
  subject     String
  body        String
  // { kinds: string[], stages: string[], tags: string[], cityId?: string, consentOnly: boolean }
  audience    Json      @default("{}")
  // draft | scheduled | sending | sent | cancelled
  status      String    @default("draft")
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sends CampaignSend[]

  @@index([status, scheduledAt])
}

model CampaignSend {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email      String
  name       String    @default("")
  // queued | sent | failed | skipped
  status     String    @default("queued")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

/// Addresses that must never receive marketing mail again.
model EmailSuppression {
  email     String   @id
  // unsubscribed | bounced | complaint | manual
  reason    String   @default("unsubscribed")
  createdAt DateTime @default(now())
}

/// A social media post, drafted here and published to the Facebook Page by
/// the outbox job (when FB_PAGE_TOKEN is set) or posted by hand.
model SocialPost {
  id          String    @id @default(cuid())
  // facebook | instagram | linkedin | x | tiktok
  channel     String    @default("facebook")
  body        String
  imageUrl    String?
  link        String?
  // draft | scheduled | published | failed | manual
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String?
  error       String?
  batch       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
}

/// A paid campaign on Meta, Google or elsewhere. Leads carry the
/// utm_campaign they arrived with, so cost per lead is computed, not typed.
model AdCampaign {
  id          String   @id @default(cuid())
  name        String
  // meta | google | tiktok | reddit | other
  platform    String   @default("meta")
  objective   String   @default("leads")
  // planned | active | paused | ended
  status      String   @default("planned")
  utmCampaign String   @unique
  landingUrl  String
  // Whole units of `currency`.
  dailyBudget Int      @default(0)
  spend       Int      @default(0)
  currency    String   @default("USD")
  startDate   String?
  endDate     String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// An invitation to list free for a week (or `days`).
model TrialInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  email       String
  name        String    @default("")
  days        Int       @default(7)
  // pending | sent | redeemed | expired | revoked
  status      String    @default("pending")
  note        String?
  sentAt      DateTime?
  expiresAt   DateTime
  redeemedAt  DateTime?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([status])
}

/// Who did what in the founder view.
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String   @default("")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Small editable settings (mailing address for the email footer, sender
/// name) and job heartbeats.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A renter's way from viewing to move-out, run by the team. Separate from
/// Lease (signed in the app): most bookings start from a lead without an
/// account.
model Booking {
  id                 String    @id @default(cuid())
  leadId             String?
  listingId          String?
  contactId          String?
  renterName         String
  renterEmail        String
  renterPhone        String?
  // viewing | application | approved | signed | moved_in | moved_out | lost
  stage              String    @default("viewing")
  viewingAt          DateTime?
  viewingMode        String?
  viewingConfirmedAt DateTime?
  moveIn             String?
  moveOut            String?
  monthlyAllIn       Int?
  currency           String    @default("USD")
  note               String?
  lostReason         String?
  renewalRemindedAt  DateTime?
  ownerId            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([stage])
  @@index([listingId])
  @@index([leadId])
  @@index([viewingAt])
}

/// A Trust Radar signal someone reviewed and cleared, so it stays quiet.
model TrustDismissal {
  id        String   @id @default(cuid())
  signal    String   @unique
  note      String   @default("")
  byId      String
  createdAt DateTime @default(now())
}

/// "When this happens, do that." Recipes the team switches on.
model Playbook {
  id        String   @id @default(cuid())
  name      String
  trigger   String
  // minutes to wait after the trigger moment
  waitMinutes Int    @default(60)
  action    String
  subject   String   @default("")
  body      String   @default("")
  enabled   Boolean  @default(true)
  runs      Int      @default(0)
  lastRunAt DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs PlaybookRun[]
}

/// One playbook firing on one target — at most once per target.
model PlaybookRun {
  id         String   @id @default(cuid())
  playbookId String
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  status     String   @default("done")
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@unique([playbookId, targetType, targetId])
  @@index([createdAt])
}


/* ------------------------------------------------------------------------
   Books: RentLeaks' own accounting — income, expenses, invoices.
   RentLeaks never holds renter money; these are the company's books.
   ------------------------------------------------------------------------ */

/// One line in the books. Amounts in cents. Voided lines stay for the audit trail.
model LedgerEntry {
  id             String    @id @default(cuid())
  // YYYY-MM-DD, the day it counts in the books
  date           String
  // income | expense
  kind           String
  category       String
  amountCents    Int
  currency       String    @default("USD")
  description    String    @default("")
  counterparty   String    @default("")
  // card | bank | stripe | cash | other
  method         String    @default("")
  reference      String?
  receiptUrl     String?
  deductible     Boolean   @default(true)
  // The client this line belongs to, when there is one.
  userId         String?
  invoiceId      String?
  // Where an automatic line came from ("pay:<id>", "refund:<id>", "ad:<id>:<total>"); unique so a sync never doubles.
  sourceKey      String?   @unique
  // Monthly repeat: the cron copies the line into each new month.
  repeatMonthly  Boolean   @default(false)
  repeatedFromId String?
  voidedAt       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([repeatedFromId, date])
  @@index([date])
  @@index([kind, date])
  @@index([userId])
}

/// An invoice RentLeaks sends (sponsorship deals, operators, manual plans).
model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  userId         String?
  billToName     String
  billToEmail    String
  // draft | sent | paid | void
  status         String    @default("draft")
  issueDate      String
  dueDate        String
  currency       String    @default("USD")
  // JSON [{ description, quantity, unitCents }]
  itemsJson      String    @default("[]")
  subtotalCents  Int       @default(0)
  taxCents       Int       @default(0)
  totalCents     Int       @default(0)
  note           String    @default("")
  sentAt         DateTime?
  lastReminderAt DateTime?
  reminders      Int       @default(0)
  paidAt         DateTime?
  paidMethod     String?
  createdById    String?
  // The enterprise engagement this invoice bills, when there is one.
  engagementId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([dueDate])
  @@index([engagementId])
}

/// A private note on a client account, visible to the desk only.
model ClientNote {
  id        String   @id @default(cuid())
  userId    String
  body      String
  pinned    Boolean  @default(false)
  byId      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A receipt file (photo or PDF) kept privately in the database — never on
/// the public media domain. Uploaded before its ledger line exists, then
/// attached on save; unattached uploads are removed after a day.
model Receipt {
  id           String   @id @default(cuid())
  entryId      String?
  fileName     String
  contentType  String
  size         Int
  sha256       String
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([entryId])
  @@index([createdAt])
}

/**
 * ------------------------------------------------------------------------
 * Enterprise: services for landlords, corporations, developers and
 * out-of-state owners — brokerage, marketing, media and management.
 * The catalogue lives in src/lib/enterprise/catalog.ts.
 * ------------------------------------------------------------------------
 */

/// A request from rentleaks.com/enterprise/. Asks about the property, never about people.
model ServiceRequest {
  id            String    @id @default(cuid())
  // new | contacted | proposal | won | lost | spam
  status        String    @default("new")
  name          String
  email         String
  phone         String?
  company       String?
  // landlord | company | developer | operator | investor | other
  role          String    @default("landlord")
  // building | complex | portfolio | multi_room | furnished | single | development
  propertyKind  String    @default("building")
  units         Int?
  buildings     Int?
  market        String?
  address       String?
  ownerLocation String?
  outOfState    Boolean   @default(false)
  // JSON ServiceId[] and add-on ids
  services      String    @default("[]")
  addOns        String    @default("[]")
  packageId     String?
  // now | 30d | 90d | exploring
  timeline      String    @default("exploring")
  message       String    @default("")
  consent       Boolean   @default(false)
  source        String    @default("web")
  campaign      String?
  referrer      String?
  score         Int       @default(0)
  note          String?
  lostReason    String?
  assignedToId  String?
  contactedAt   DateTime?
  ackSentAt     DateTime?
  engagementId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// What a client signed up for: one package (or a custom scope) and its fee.
model Engagement {
  id                String    @id @default(cuid())
  title             String
  clientName        String
  clientEmail       String
  clientCompany     String?
  clientPhone       String?
  userId            String?
  requestId         String?
  // marketing | brokerage | management | owners
  track             String
  packageId         String?
  // JSON ServiceId[]
  services          String    @default("[]")
  // proposal | signed | active | paused | completed | cancelled
  status            String    @default("proposal")
  // flat | monthly | per_unit | percent | commission
  feeModel          String    @default("monthly")
  amountCents       Int       @default(0)
  // basis points: 800 = 8%
  pctBp             Int       @default(0)
  units             Int       @default(0)
  // Monthly rent the percent or commission applies to.
  rentRollCents     Int       @default(0)
  currency          String    @default("USD")
  market            String?
  address           String?
  ownerLocation     String?
  // Where the signed agreement is kept (e-sign envelope, drive link, file name).
  agreementRef      String?
  agreementSignedOn String?
  proposalSentAt    DateTime?
  startDate         String?
  endDate           String?
  note              String?
  ownerId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tasks      EngagementTask[]
  properties ManagedProperty[]

  @@index([status])
  @@index([clientEmail])
  @@index([userId])
}

/// A deliverable on an engagement's checklist.
model EngagementTask {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title        String
  dueDate      String?
  position     Int        @default(0)
  doneAt       DateTime?
  doneById     String?
  createdAt    DateTime   @default(now())

  @@index([engagementId, position])
  @@index([doneAt, dueDate])
}

/// A property RentLeaks manages or leases for an owner.
model ManagedProperty {
  id            String      @id @default(cuid())
  engagementId  String?
  engagement    Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  name          String
  address       String      @default("")
  market        String?
  // building | complex | multi_room | furnished | single | portfolio | development
  kind          String      @default("building")
  units         Int         @default(1)
  occupied      Int         @default(0)
  rentRollCents Int         @default(0)
  pctBp         Int         @default(0)
  flatFeeCents  Int         @default(0)
  currency      String      @default("USD")
  ownerName     String
  ownerEmail    String
  ownerLocation String?
  // onboarding | active | paused | ended
  status        String      @default("onboarding")
  // JSON listing ids on RentLeaks for these units
  listingIds    String      @default("[]")
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  statements OwnerStatement[]

  @@index([status])
  @@index([ownerEmail])
}

/// The monthly statement an owner gets: rent collected (client money, held in
/// trust — never RentLeaks income), expenses paid for them, our fee, net.
model OwnerStatement {
  id             String          @id @default(cuid())
  propertyId     String
  property       ManagedProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // YYYY-MM
  month          String
  collectedCents Int             @default(0)
  expensesCents  Int             @default(0)
  feeCents       Int             @default(0)
  netCents       Int             @default(0)
  occupied       Int             @default(0)
  // JSON [{ label, amountCents }]
  expenseLines   String          @default("[]")
  note           String          @default("")
  sentAt         DateTime?
  invoiceId      String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([propertyId, month])
  @@index([month])
}

/* ------------------------------------------------------------------------
 * Broker network: tenants who hire a broker, licensed partners who receive
 * them as referrals, and the in-app e-signed agreements between them.
 * The rules and templates live in src/lib/network/core.ts.
 * ------------------------------------------------------------------------
 */

/// A licensed broker or agent in the referral program.
model NetworkPartner {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String
  brokerage       String
  // salesperson | associate_broker | broker
  licenseType     String
  licenseNumber   String
  licenseState    String
  licenseExpires  String?
  supervisorName  String?
  supervisorEmail String?
  // JSON string[]
  markets         String    @default("[]")
  specialties     String    @default("[]")
  languages       String    @default("[]")
  bio             String    @default("")
  website         String?
  capacity        Int       @default(5)
  referralPctBp   Int       @default(2500)
  // applied | verifying | active | paused | rejected
  status          String    @default("applied")
  portalTokenHash String?   @unique
  agreementId     String?
  verifiedAt      DateTime?
  verifiedById    String?
  verifyNote      String?
  lastOfferedAt   DateTime?
  ratingSum       Int       @default(0)
  ratingCount     Int       @default(0)
  source          String    @default("web")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offers NetworkOffer[]

  @@index([status])
  @@index([licenseState, status])
}

/// A tenant's brief: they want to hire a broker.
model NetworkSearch {
  id              String    @id @default(cuid())
  // new | matching | proposals | chosen | signed | touring | applied | leased | closed | lost | spam
  status          String    @default("new")
  name            String
  email           String
  phone           String?
  city            String
  state           String
  // JSON string[]
  neighborhoods   String    @default("[]")
  homeType        String    @default("apartment")
  buildingAge     String    @default("any")
  bedrooms        Int?
  budgetMin       Int?
  budgetMax       Int
  moveIn          String?
  // long | mid | flexible
  term            String    @default("long")
  termMonths      Int?
  mustHaves       String    @default("[]")
  language        String?
  // none | pct | months | flat
  feeCapType      String    @default("none")
  feeCapValue     Int       @default(0)
  notes           String    @default("")
  consent         Boolean   @default(false)
  source          String    @default("web")
  campaign        String?
  referrer        String?
  score           Int       @default(0)
  roomTokenHash   String    @unique
  chosenPartnerId String?
  agreementId     String?
  stageAt         DateTime?
  leasedAt        DateTime?
  lostReason      String?
  rating          Int?
  note            String?
  noMatchAt       DateTime?
  nudgedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offers NetworkOffer[]

  @@index([status, createdAt])
  @@index([email])
  @@index([chosenPartnerId])
}

/// One partner's chance at one search.
model NetworkOffer {
  id          String         @id @default(cuid())
  searchId    String
  search      NetworkSearch  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     NetworkPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // offered | proposed | declined | expired | chosen | not_chosen | withdrawn
  status      String         @default("offered")
  matchScore  Int            @default(0)
  // JSON string[]
  reasons     String         @default("[]")
  feeType     String?
  feeValue    Int?
  pitch       String         @default("")
  declineWhy  String?
  offeredAt   DateTime       @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  chosenAt    DateTime?

  @@unique([searchId, partnerId])
  @@index([partnerId, status])
  @@index([status, expiresAt])
}

/// An envelope: one frozen document, its signers and its audit trail.
model Agreement {
  id          String    @id @default(cuid())
  // tenant_rep | partner_referral
  kind        String
  version     String
  title       String
  // JSON Section[] and terms, frozen at creation; docHash = sha256(canonical text)
  sections    String
  terms       String    @default("{}")
  docHash     String
  // sent | partial | completed | declined | expired | voided
  status      String    @default("sent")
  searchId    String?
  partnerId   String?
  expiresAt   DateTime
  completedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  signers AgreementSigner[]
  events  AgreementEvent[]

  @@index([kind, status])
  @@index([searchId])
  @@index([partnerId])
}

model AgreementSigner {
  id             String    @id @default(cuid())
  agreementId    String
  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  // tenant | partner | supervisor | rentleaks
  role           String
  name           String
  email          String
  order          Int       @default(0)
  tokenHash      String    @unique
  // pending | viewed | signed | declined
  status         String    @default("pending")
  consentAt      DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  // typed | drawn
  signatureKind  String?
  signedName     String?
  signatureImage String?
  ip             String?
  userAgent      String?
  declinedAt     DateTime?
  declineReason  String?
  remindedAt     DateTime?
  reminders      Int       @default(0)
  signedById     String?
  createdAt      DateTime  @default(now())

  @@index([agreementId, order])
  @@index([email])
}

model AgreementEvent {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  signerId    String?
  // created | sent | viewed | consented | signed | declined | completed | reminded | voided | expired | downloaded
  type        String
  detail      String    @default("")
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([agreementId, createdAt])
}

/// A lease a partner closed for a referred tenant, and the referral fee on it.
model NetworkDeal {
  id               String    @id @default(cuid())
  searchId         String    @unique
  partnerId        String
  leaseSignedOn    String
  monthlyRentCents Int
  grossFeeCents    Int
  referralPctBp    Int
  referralDueCents Int
  // reported | invoiced | paid | waived | disputed
  status           String    @default("reported")
  invoiceId        String?
  address          String    @default("")
  note             String    @default("")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([partnerId])
  @@index([status])
}
