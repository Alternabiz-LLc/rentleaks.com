DATABASE_URL="postgresql://rentleaks:rentleaks@localhost:5434/rentleaks?schema=public"
# Same as DATABASE_URL locally; on Neon use the non-pooled address (DEPLOY.md)
DIRECT_URL="postgresql://rentleaks:rentleaks@localhost:5434/rentleaks?schema=public"
APP_URL="http://localhost:3000"
CATALOG_ORIGIN="http://localhost:8765"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CATALOG_ORIGIN="http://localhost:8765"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Sandbox catalogue (Alternabiz LLC sandbox) — optional; Checkout falls back to price_data
STRIPE_PRICE_LISTING_WEEK="price_1UIJavL7FHqV7UTB2g0XoMjq"
STRIPE_PRICE_LISTING_MONTH="price_1UIJavL7FHqV7UTBXJXpjpg2"
STRIPE_PRICE_SPONSORED_WEEK="price_1UIJhJL7FHqV7UTBma8oNVSH"
STRIPE_PRICE_SPONSORED_MONTH="price_1UIJjBL7FHqV7UTB44mXwMFO"

# Mobile API (MOBILE-APP.md)
# Shared secret for GET /api/v1/cron/alerts (saved-search push job)
# Seals two-factor secrets at rest. 32+ random characters; the deploy script
# creates it on Cloudflare. Never change it once staff have set up two-factor.
AUTH_SECRET=
CRON_SECRET=
# Optional: Expo push access token (enhanced push security in EAS)
EXPO_ACCESS_TOKEN=
# Password-reset email (Resend). Without a key, reset links are printed to the server console.
RESEND_API_KEY=
MAIL_FROM="RentLeaks <no-reply@rentleaks.com>"
# App links (served at /.well-known/* on the APP_URL host)
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.alternabiz.rentleaks
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=com.alternabiz.rentleaks

# Facebook / Meta (marketing/facebook/PAGE-KIT.md)
FACEBOOK_DOMAIN_VERIFICATION=
META_FEED_KEY=

# Production hosting (DEPLOY.md)
# Photo/video uploads to an S3-compatible bucket (Cloudflare R2). Leave empty to use local disk.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Shared rate limiting across server instances (Upstash Redis REST). Leave empty for in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
