DATABASE_URL="postgresql://rentleaks:rentleaks@localhost:5434/rentleaks?schema=public"
# Same as DATABASE_URL locally; on Neon use the non-pooled address (DEPLOY.md)
DIRECT_URL="postgresql://rentleaks:rentleaks@localhost:5434/rentleaks?schema=public"
APP_URL="http://localhost:3100"
CATALOG_ORIGIN="http://localhost:8765"
NEXT_PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_CATALOG_ORIGIN="http://localhost:8765"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Sandbox catalogue (Alternabiz LLC sandbox) — optional; Checkout falls back to price_data
STRIPE_PRICE_LISTING_WEEK="price_1UIJavL7FHqV7UTB2g0XoMjq"
STRIPE_PRICE_LISTING_MONTH="price_1UIJavL7FHqV7UTBXJXpjpg2"
# Leave sponsored price IDs empty so Checkout uses +$35/week and +$130/month from plans.ts
STRIPE_PRICE_SPONSORED_WEEK=""
STRIPE_PRICE_SPONSORED_MONTH=""

# Mobile API (MOBILE-APP.md)
# Shared secret for GET /api/v1/cron/alerts (saved-search push job)
# Seals two-factor secrets at rest. 32+ random characters; the deploy script
# creates it on Cloudflare. Never change it once staff have set up two-factor.
AUTH_SECRET=
CRON_SECRET=
# Optional: Expo push access token (enhanced push security in EAS)
EXPO_ACCESS_TOKEN=
# Password-reset email (Resend). Without a key, reset links are printed to the server console.
RESEND_API_KEY=
MAIL_FROM="RentLeaks <no-reply@rentleaks.com>"
# App links (served at /.well-known/* on the APP_URL host)
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.alternabiz.rentleaks
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=com.alternabiz.rentleaks

# Facebook / Meta (marketing/facebook/PAGE-KIT.md)
FACEBOOK_DOMAIN_VERIFICATION=
META_FEED_KEY=

# Production hosting (DEPLOY.md)
# Photo/video uploads to an S3-compatible bucket (Cloudflare R2). Leave empty to use local disk.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Shared rate limiting across server instances (Upstash Redis REST). Leave empty for in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional Node ingress header, only when a trusted reverse proxy overwrites it.
# Cloudflare Workers trust their platform-provided cf-connecting-ip automatically.
TRUSTED_PROXY_HEADER=
# Optional Resend signed delivery callbacks at /api/email/webhook.
RESEND_WEBHOOK_SECRET=
# Chargebee Product Catalog 2.0 / GoCardless. Enable after sandbox acceptance.
# Connect GoCardless and configure bank-only routing in Chargebee first.
CHARGEBEE_BANK_ENABLED=false
CHARGEBEE_SITE=rentleaks-test
CHARGEBEE_API_KEY=
CHARGEBEE_WEBHOOK_USER=
CHARGEBEE_WEBHOOK_PASSWORD=
CHARGEBEE_PRICE_LISTING_WEEK=rentleaks-listing-USD-Weekly
CHARGEBEE_PRICE_LISTING_MONTH=rentleaks-listing-USD-Monthly
CHARGEBEE_PRICE_SPONSORED_WEEK=rentleaks-sponsored-USD-Weekly
CHARGEBEE_PRICE_SPONSORED_MONTH=rentleaks-sponsored-USD-Monthly

# Lease-break listing prices ($15/week or $60/month). Configure before enabling bank checkout.
STRIPE_PRICE_LEASE_BREAK_WEEK=
STRIPE_PRICE_LEASE_BREAK_MONTH=
CHARGEBEE_PRICE_LEASE_BREAK_WEEK=lease-break-weekly-usd
CHARGEBEE_PRICE_LEASE_BREAK_MONTH=lease-break-monthly-usd
